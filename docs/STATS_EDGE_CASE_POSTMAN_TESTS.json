    {
      "name": "Test 4.3.4 - Date Formatting for lastActiveDate",
      "item": [
        {
          "name": "GET /stats/streak - Verify YYYY-MM-DD format",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stats/streak",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stats", "streak"]
            },
            "description": "Verify lastActiveDate is formatted as YYYY-MM-DD with no time component. Use any user with a streak record."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response has lastActiveDate field\", function () {",
                  "  pm.expect(body).to.have.property('lastActiveDate');",
                  "});",
                  "",
                  "if (body.lastActiveDate !== null) {",
                  "  pm.test(\"lastActiveDate matches YYYY-MM-DD format\", function () {",
                  "    const dateRegex = /^\\d{4}-\\d{2}-\\d{2}$/;",
                  "    pm.expect(body.lastActiveDate).to.match(dateRegex);",
                  "  });",
                  "",
                  "  pm.test(\"lastActiveDate does not include time component\", function () {",
                  "    pm.expect(body.lastActiveDate).to.not.include('T');",
                  "    pm.expect(body.lastActiveDate).to.not.include(':');",
                  "  });",
                  "",
                  "  pm.test(\"lastActiveDate is a valid date\", function () {",
                  "    const date = new Date(body.lastActiveDate);",
                  "    pm.expect(date.toString()).to.not.eql('Invalid Date');",
                  "  });",
                  "",
                  "  console.log('✅ Test 4.3.4 PASSED: lastActiveDate formatted as YYYY-MM-DD:', body.lastActiveDate);",
                  "} else {",
                  "  console.log('⚠️ Test 4.3.4 SKIPPED: lastActiveDate is null (no streak record)');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
