# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database
DATABASE_URL=postgresql://postgres.ref:password@pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.ref:password@pooler.supabase.com:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:password@your-upstash-url.upstash.io:6379

# Auth
COOKIE_SECRET=your-random-64-char-hex-string

# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173

# Dev route protection
DEV_SECRET_TOKEN=your-random-64-char-hex-string
