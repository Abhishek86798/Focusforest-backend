# =============================================================================
# FocusForest Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port the Express server listens on
# Default: 3000
PORT=3000

# Frontend URL for CORS configuration
# Used to allow cross-origin requests from your frontend
# Development: http://localhost:5173 (Vite default)
# Production: https://your-frontend-domain.com
APP_URL=http://localhost:5173

# Secret key for signing cookies
# Generate a random string: openssl rand -base64 32
# Used by cookie-parser middleware for httpOnly cookie security
COOKIE_SECRET=your-random-secret-key-here

# Node environment
# Values: development | production
# Affects logging levels and dev-only routes
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# -----------------------------------------------------------------------------

# Prisma connection string for database queries
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (Transaction mode)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:your-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection string for Prisma migrations
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (Session mode)
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxxx:your-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Authentication — Supabase Auth
# -----------------------------------------------------------------------------

# Supabase project URL
# Format: https://xxxxxxxxxxxxx.supabase.co
# Get from: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Supabase anonymous (public) key
# Used for client-side auth operations like signInWithPassword
# Get from: Supabase Dashboard → Project Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1yZWYiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYxNjE2MTYxNiwiZXhwIjoxOTMxNzM3NjE2fQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service role (secret) key
# Full admin access, bypasses Row Level Security (RLS)
# NEVER expose this to the client — server-side only
# Get from: Supabase Dashboard → Project Settings → API → Project API keys → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1yZWYiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjE2MTYxNjE2LCJleHAiOjE5MzE3Mzc2MTZ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Cache & Leaderboard — Upstash Redis
# -----------------------------------------------------------------------------

# Upstash Redis REST API URL
# Format: https://xxxxxx-xxxxx-xxxxx.upstash.io
# Get from: Upstash Console → Your Database → REST API → UPSTASH_REDIS_REST_URL
# Used for: leaderboard sorted sets, future BullMQ job queues
UPSTASH_REDIS_REST_URL=https://xxxxxx-xxxxx-xxxxx.upstash.io

# Upstash Redis REST API token
# Get from: Upstash Console → Your Database → REST API → UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
