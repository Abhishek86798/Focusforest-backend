generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  avatarUrl         String?            @map("avatar_url")
  utcOffset         Int                @default(0) @map("utc_offset")
  isPrivate         Boolean            @default(false) @map("is_private")
  preferences       Json?              @default("{}")
  createdAt         DateTime           @default(now()) @map("created_at")
  dailyTrees        DailyTree[]
  groupMemberships  GroupMember[]
  groupsAdmin       Group[]            @relation("GroupAdmin")
  pushSubscriptions PushSubscription[]
  sessions          Session[]
  streak            Streak?

  @@map("users")
}

model Session {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  variant         Variant
  focusMinutes    Int          @map("focus_minutes")
  taskText        String?      @map("task_text")
  taskStatus      TaskStatus   @default(none) @map("task_status")
  stageProgress   Float        @map("stage_progress")
  clientSessionId String       @unique @map("client_session_id")
  state           SessionState @default(active) @map("state")
  startedAt       DateTime?    @map("started_at")
  expectedEndAt   DateTime?    @map("expected_end_at")
  abandonedAt     DateTime?    @map("abandoned_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, state])
  @@map("sessions")
}

model DailyTree {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  date             DateTime  @db.Date
  stage            Int       @default(0)
  glowLevel        Int       @default(0) @map("glow_level")
  totalSessions    Int       @default(0) @map("total_sessions")
  sessionsWithTask Int       @default(0) @map("sessions_with_task")
  isBare           Boolean   @default(false) @map("is_bare")
  finalisedAt      DateTime? @map("finalised_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_trees")
}

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  currentStreak  Int      @default(0) @map("current_streak")
  longestStreak  Int      @default(0) @map("longest_streak")
  lastActiveDate DateTime @map("last_active_date") @db.Date
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model Group {
  id          String        @id @default(uuid())
  name        String
  adminUserId String        @map("admin_user_id")
  inviteCode  String        @unique @map("invite_code")
  memberCount Int           @default(1) @map("member_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  members     GroupMember[]
  admin       User          @relation("GroupAdmin", fields: [adminUserId], references: [id])

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

enum Variant {
  sprint
  classic
  deep_work
  flow
  custom
}

enum TaskStatus {
  completed
  carried
  none
}

enum SessionState {
  active
  completed
  abandoned
}
