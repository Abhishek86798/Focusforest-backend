// FocusForest — Prisma Schema
// Run `npx prisma validate` after every change.
// Run `npx prisma migrate dev` to apply migrations.
//
// DB: Supabase PostgreSQL
// ORM: Prisma 5+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// USERS
// ---------------------------------------------------------------------------
// Mirrors the Supabase Auth user. Created via a trigger or manually on signup.
// utc_offset: user's local UTC offset in minutes (e.g. +330 for IST, -300 for EST)
// Used by the midnight cron to batch users by local midnight.

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  utcOffset Int      @default(0) @map("utc_offset") // minutes from UTC
  createdAt DateTime @default(now()) @map("created_at")

  sessions          Session[]
  dailyTrees        DailyTree[]
  streak            Streak?
  groupsAdmin       Group[]            @relation("GroupAdmin")
  groupMemberships  GroupMember[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// SESSIONS
// ---------------------------------------------------------------------------
// One row per completed focus session.
// client_session_id: UUID generated by the client. Used to deduplicate retries.
// stage_progress: server-computed value — NEVER set by the client.
// task_status: what the user chose at the end-of-session popup.

model Session {
  id              String     @id @default(uuid())
  userId          String     @map("user_id")
  variant         Variant
  focusMinutes    Int        @map("focus_minutes")
  taskText        String?    @map("task_text")
  taskStatus      TaskStatus @default(none) @map("task_status")
  stageProgress   Float      @map("stage_progress") // server-computed: (focus_minutes / 25) × task_multiplier
  clientSessionId String     @unique @map("client_session_id") // UUID for deduplication
  createdAt       DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// DAILY TREES
// ---------------------------------------------------------------------------
// One row per user per calendar day. Created as a seed on the first session of the day.
// stage: 0 (seed) → 4 (full tree). Capped at 4.
// glow_level: 0–4, computed as tasks_completed / total_sessions_today.
// is_bare: true if finalised with 0 sessions (missed day). Cannot be backdated.
// finalised_at: set by the midnight cron job.

model DailyTree {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  date             DateTime  @db.Date // local calendar date (no time, no timezone)
  stage            Int       @default(0) // 0–4
  glowLevel        Int       @default(0) @map("glow_level") // 0–4
  totalSessions    Int       @default(0) @map("total_sessions")
  sessionsWithTask Int       @default(0) @map("sessions_with_task")
  isBare           Boolean   @default(false) @map("is_bare")
  finalisedAt      DateTime? @map("finalised_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // one tree per user per day
  @@index([userId, date])
  @@map("daily_trees")
}

// ---------------------------------------------------------------------------
// STREAKS
// ---------------------------------------------------------------------------
// One row per user. Created on first session. Updated by midnight cron.
// last_active_date: the most recent calendar day with at least 1 session.
// Used to determine if the streak was broken.

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  currentStreak  Int      @default(0) @map("current_streak")
  longestStreak  Int      @default(0) @map("longest_streak")
  lastActiveDate DateTime @map("last_active_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

// ---------------------------------------------------------------------------
// GROUPS
// ---------------------------------------------------------------------------
// Max 5 members including creator. inviteCode is a 6-digit alphanumeric string.
// member_count is a denormalised counter kept in sync via triggers or manually.
// Once member_count == 5, the invite link is disabled.

model Group {
  id          String   @id @default(uuid())
  name        String
  adminUserId String   @map("admin_user_id")
  inviteCode  String   @unique @map("invite_code") // 6-character alphanumeric
  memberCount Int      @default(1) @map("member_count") // max 5
  createdAt   DateTime @default(now()) @map("created_at")

  admin   User          @relation("GroupAdmin", fields: [adminUserId], references: [id])
  members GroupMember[]

  @@map("groups")
}

// ---------------------------------------------------------------------------
// GROUP MEMBERS
// ---------------------------------------------------------------------------

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId]) // can't join same group twice
  @@map("group_members")
}

// ---------------------------------------------------------------------------
// PUSH SUBSCRIPTIONS
// ---------------------------------------------------------------------------
// Web Push API subscription objects. Stored per device per user.
// p256dh and auth are the ECDH public key and auth secret from the browser PushSubscription.

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Variant {
  sprint
  classic
  deep_work
  flow
  custom
}

enum TaskStatus {
  completed
  carried
  none
}
